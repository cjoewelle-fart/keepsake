{
  "name": "keepsake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode testbuild",
    "build:artifact-test": "tsc -b && vite build --mode artifact-test && node scripts/make-artifact.mjs --test dist-artifact-test/page",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run tests",
    "eval": "vitest run eval",
    "fixture": "python3 scripts/make_fixture.py fixtures/recovery",
    "e2e": "node scripts/e2e.mjs",
    "notices": "node scripts/make_notices.mjs",
    "offline-check": "node scripts/offline-check.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "pilot-e2e": "node scripts/pilot-e2e.mjs",
    "gate": "npm test && npm run build && npm run build:test && npm run fixture && npm run eval -- --silent=false && npm run e2e && npm run offline-check && npm run a11y && node scripts/a11y-check.mjs --fixture \"fixtures/pilot/Recovered from old phone\" --shots e2e-shots/a11y-pilot && node scripts/qa-save-opfs/run.mjs && npm run pilot-e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "browser-fs-access": "^0.38.0",
    "comlink": "^4.4.2",
    "exifr": "^7.1.3",
    "libheif-js": "1.23.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.4"
  }
}
